# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# Groq API key (free at https://console.groq.com/keys). Without it the trainer still works;
# the AI features then ask each learner for their own key.
GROQ_API_KEY=

# Optional: models to try in order (a retired, rate-limited or busy model hands over to the next)
# GROQ_MODELS_QUALITY=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_MODELS_FAST=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# Optional: require this code for AI requests on a public deployment (keeps strangers off your quota)
# ACCESS_CODE=

# Optional limits
# RATE_PER_MINUTE=12
# RATE_PER_DAY=300
# DAILY_CAP=1500

# Set to 1 behind a reverse proxy (Render, Fly.io, nginx) so rate limits see the real client IP
# TRUST_PROXY=1
